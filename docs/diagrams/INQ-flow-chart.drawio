        </mxCell>
        <mxCell id="EBXz4PM_VVVrD36lLtE7-1" value="\(E_{Ewald}\) has 4 terms: A real-space term, a fourier-space term, a self interaction term, and a G=0 (i.e. fourier-space) term. The fourier-space term and the G=0 are calculated togther in ewald_fourier_*" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="3883.5" y="2865" width="306.5" height="30" as="geometry" />
        </mxCell>
        <mxCell id="NaZFFOehNBS8Cp5DxfMj-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=1;entryDx=0;entryDy=0;dashed=1;dashPattern=12 12;curved=1;" parent="1" source="f71BgP6-HMzk51Cafj64-19" target="oTFmGUG1_qoUw0dJdVI4-36" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">

            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="CrspYY1GGKWctcYOVzqP-2" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="CrspYY1GGKWctcYOVzqP-1" target="vLbwB-sf92mf1xhOi24_-1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CrspYY1GGKWctcYOVzqP-1" value="The pseudopod library/pseudopotential object contains information that is element specific. The host code (INQ) has to provide atom specific (e.g. atomic coordinates) information and processing." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1270" y="2277" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mVFty8zJsob5PMEK62vW-1" value="Orthogonalization&lt;div&gt;&lt;div&gt;\(\langle \psi_i |\hat{S} | \psi_j&amp;nbsp; \rangle = \delta_{ij}\)&lt;/div&gt;&lt;div style=&quot;font-size: 2px;&quot;&gt;&lt;br style=&quot;font-weight: 400;&quot;&gt;&lt;/div&gt;&lt;/div&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;" parent="1" vertex="1">
          <mxGeometry x="2008.75" y="1520" width="290" height="300" as="geometry" />
        </mxCell>
        <mxCell id="mVFty8zJsob5PMEK62vW-8" value="" style="group" parent="mVFty8zJsob5PMEK62vW-1" vertex="1" connectable="0">
          <mxGeometry x="22.43" y="115" width="245.14" height="45" as="geometry" />
        </mxCell>
        <mxCell id="mVFty8zJsob5PMEK62vW-5" value="Calculate \(S_{ij} = \langle \psi_i|\hat{S}|\psi_j\rangle\)&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 179, 102);&quot;&gt;inq&lt;/span&gt;::&lt;span style=&quot;background-color: rgb(255, 255, 102);&quot;&gt;hamiltonian&lt;/span&gt;::&lt;span style=&quot;background-color: rgb(102, 178, 255);&quot;&gt;ks_hamiltonian&lt;/span&gt;::&lt;span style=&quot;background-color: rgb(102, 255, 102);&quot;&gt;overlap&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="mVFty8zJsob5PMEK62vW-8" vertex="1">
          <mxGeometry width="245.14000000000001" height="45" as="geometry" />
        </mxCell>
        <mxCell id="HXL_9bEfjIU3hshokx6L-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="mVFty8zJsob5PMEK62vW-1" source="IcmxT7rCk6kpcZVUdnJI-2" target="mVFty8zJsob5PMEK62vW-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IcmxT7rCk6kpcZVUdnJI-2" value="\(\hat{S}=1+\sum_{ij}| \tilde{p}_i\rangle s^{a}_{ij}\langle \tilde{p}_j|\) for PAW/USPP or \(\hat{S}=1\) for NCPP" style="rounded=1;whiteSpace=wrap;html=1;" parent="mVFty8zJsob5PMEK62vW-1" vertex="1">
          <mxGeometry x="46.88" y="50" width="196.25" height="40" as="geometry" />
        </mxCell>
        <mxCell id="HXL_9bEfjIU3hshokx6L-7" value="" style="group" vertex="1" connectable="0" parent="mVFty8zJsob5PMEK62vW-1">
          <mxGeometry x="35.94" y="186" width="218.12" height="30" as="geometry" />
        </mxCell>
        <mxCell id="HXL_9bEfjIU3hshokx6L-8" value="Perform Cholesky decomposition&lt;br&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;\(S=LL^\dagger\)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;where \(L\) is a lower triangle&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="HXL_9bEfjIU3hshokx6L-7">
          <mxGeometry width="218.12000000000003" height="30" as="geometry" />
        </mxCell>
        <mxCell id="HXL_9bEfjIU3hshokx6L-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="mVFty8zJsob5PMEK62vW-1" source="mVFty8zJsob5PMEK62vW-5" target="HXL_9bEfjIU3hshokx6L-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HXL_9bEfjIU3hshokx6L-10" value="Rotate wavefunctions&lt;div&gt;\(|\psi_{\rm{ortho}}\rangle = |\psi\rangle L^{-1}\)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="mVFty8zJsob5PMEK62vW-1">

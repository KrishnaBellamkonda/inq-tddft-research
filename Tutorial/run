#!/bin/bash
# Usage: ./run <target>
# Example: ./run h2
#          ./run n2
#
# Rebuilds only the named target, then runs it from its source directory.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD_DIR="$SCRIPT_DIR/build"
TARGET="$1"

if [[ -z "$TARGET" ]]; then
    echo "Usage: $0 <target>"
    echo "Available targets:"
    ls "$BUILD_DIR"/*/CMakeFiles/*.dir 2>/dev/null | sed 's|.*/CMakeFiles/||;s|\.dir||'
    exit 1
fi

# Build only the requested target
cmake --build "$BUILD_DIR" --target "$TARGET" -j"$(nproc)"

# Find and run the binary (it lives next to its .cpp file)
BINARY=$(find "$SCRIPT_DIR" -maxdepth 2 -name "$TARGET" -type f -not -path "*/build/*" | head -1)

if [[ -z "$BINARY" ]]; then
    echo "Binary '$TARGET' not found after build."
    exit 1
fi

exec "$BINARY"
